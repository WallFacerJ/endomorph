{
  "name": "@endomorph/fabric",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "generate:scenario": "node dist/cli.js",
    "generate:all": "node dist/generateAll.js",
    "evaluate": "node dist/evaluateCli.js",
    "bundle:standalone": "node dist/bundleStandalone.js"
  },
  "dependencies": {
    "@endomorph/domain": "workspace:*",
    "@endomorph/schema": "workspace:*",
    "@endomorph/simulation": "workspace:*",
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3"
  }
}
