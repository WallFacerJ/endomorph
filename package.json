{
  "name": "endomorph",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @endomorph/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "vitest",
    "test:run": "vitest run --exclude 'e2e/**'",
    "generate:scenario": "pnpm --filter @endomorph/fabric build && pnpm --filter @endomorph/fabric generate:scenario",
    "bundle:standalone": "pnpm build && pnpm --filter @endomorph/fabric bundle:standalone",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "oxlint": "^1.78.0",
    "vitest": "^4.1.10"
  }
}
